<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="angeo" translate="label" sortOrder="500">
            <label>Angeo</label>
        </tab>

        <section id="angeo_robots_txt_aeo" translate="label" type="text" sortOrder="10"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Robots.txt AEO</label>
            <tab>angeo</tab>
            <resource>Angeo_RobotsTxtAeo::config</resource>

            <!-- ──────────── General ──────────── -->
            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>

                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable AI Bot Rules</label>
                    <comment>When enabled, AI crawler rules are automatically added to your robots.txt.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="mode" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Injection Mode</label>
                    <comment><![CDATA[<strong>Inject (recommended)</strong> — adds AI bot rules at the top of your existing robots.txt, before any wildcard block. Your existing rules are preserved.<br/><strong>Replace</strong> — replaces the entire robots.txt with the AI-optimized version. Use only if you want full control via this module.]]></comment>
                    <source_model>Angeo\RobotsTxtAeo\Model\Config\Source\Mode</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="custom_content" translate="label comment" type="textarea" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom robots.txt Content (Replace mode)</label>
                    <comment>Used only in Replace mode. If empty, safe Magento defaults will be applied. The Angeo AI block is always prepended automatically.</comment>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="mode">replace</field>
                    </depends>
                </field>
            </group>

            <!-- ──────────── AI Crawlers ──────────── -->
            <group id="bots" translate="label comment" type="text" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>AI Crawlers</label>
                <comment><![CDATA[Select which AI crawlers to allow. Allowed bots will be added with <code>Allow: /</code> before your wildcard Disallow block. Bots marked <strong>★ Critical for AEO Audit</strong> are required for a passing score in <code>angeo/module-aeo-audit</code>.]]></comment>

                <field id="oai_searchbot" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>★ OAI-SearchBot (ChatGPT live search)</label>
                    <comment>Used by ChatGPT to retrieve live product pages when answering shopping queries. Critical for AEO Audit.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="gptbot" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>★ GPTBot (OpenAI training crawler)</label>
                    <comment>OpenAI background training crawler. Block to opt out of GPT model training. Critical for AEO Audit.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="chatgpt_user" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>ChatGPT-User (ChatGPT browsing)</label>
                    <comment>Used when a ChatGPT user explicitly browses a URL. Recommended: Allow.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="perplexitybot" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>PerplexityBot (Perplexity index crawler)</label>
                    <comment>Perplexity background indexer. Respects robots.txt. Allow to appear in Perplexity results.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="perplexity_user" translate="label comment" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Perplexity-User (Perplexity real-time fetch)</label>
                    <comment>Triggered by real user queries. Note: does not respect robots.txt in practice.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="google_extended" translate="label comment" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>★ Google-Extended (Gemini / AI Overviews)</label>
                    <comment>Feeds Google Gemini and AI Overviews. Blocking does NOT affect Google Search rankings. Critical for AEO Audit.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="claudebot" translate="label comment" type="select" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>ClaudeBot (Anthropic Claude)</label>
                    <comment>Used by Claude to fetch pages for citations and answers.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="anthropic_ai" translate="label comment" type="select" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>anthropic-ai (Anthropic training crawler)</label>
                    <comment>Anthropic background training crawler. Block to opt out of Claude model training.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="claude_user" translate="label comment" type="select" sortOrder="90"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Claude-User (Claude browsing agent)</label>
                    <comment>Triggered by Claude users browsing a URL on demand.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="applebot" translate="label comment" type="select" sortOrder="100"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Applebot (Apple Intelligence / Siri)</label>
                    <comment>Apple AI crawler used by Siri and Apple Intelligence features.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="cohere_ai" translate="label comment" type="select" sortOrder="110"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>cohere-ai (Cohere training crawler)</label>
                    <comment>Cohere AI training crawler. Off by default — enable to allow Cohere training.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="amazonbot" translate="label comment" type="select" sortOrder="120"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Amazonbot (Amazon Alexa AI)</label>
                    <comment>Amazon Alexa AI training and retrieval crawler.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="meta_external_agent" translate="label comment" type="select" sortOrder="130"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Meta-ExternalAgent (Meta AI)</label>
                    <comment>Meta AI training and on-demand fetch crawler.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <!-- ──────────── Per-bot path overrides ──────────── -->
            <group id="bot_overrides" translate="label comment" type="text" sortOrder="25"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>AI Crawler Path Overrides</label>
                <comment><![CDATA[Optional per-bot overrides. Leave fields empty to use the default <code>Allow: /</code>. Paths may be entered as comma- or newline-separated lists.<br/><strong>Note:</strong> GPTBot, ClaudeBot, and Google-Extended documentedly ignore <code>Crawl-delay</code> — values set for these bots are suppressed on output.]]></comment>

                <group id="oai_searchbot" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>OAI-SearchBot</label>
                    <field id="allow" translate="label" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Allow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                    <field id="disallow" translate="label" type="textarea" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Disallow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                    <field id="crawl_delay" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Crawl-delay (seconds)</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\CrawlDelay</backend_model>
                    </field>
                </group>

                <group id="gptbot" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>GPTBot (ignores Crawl-delay)</label>
                    <field id="allow" translate="label" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Allow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                    <field id="disallow" translate="label" type="textarea" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Disallow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                </group>

                <group id="chatgpt_user" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>ChatGPT-User</label>
                    <field id="allow" translate="label" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Allow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                    <field id="disallow" translate="label" type="textarea" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Disallow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                    <field id="crawl_delay" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Crawl-delay (seconds)</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\CrawlDelay</backend_model>
                    </field>
                </group>

                <group id="perplexitybot" translate="label" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>PerplexityBot</label>
                    <field id="allow" translate="label" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Allow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                    <field id="disallow" translate="label" type="textarea" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Disallow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                    <field id="crawl_delay" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Crawl-delay (seconds)</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\CrawlDelay</backend_model>
                    </field>
                </group>

                <group id="google_extended" translate="label" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Google-Extended (ignores Crawl-delay)</label>
                    <field id="allow" translate="label" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Allow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                    <field id="disallow" translate="label" type="textarea" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Disallow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                </group>

                <group id="claudebot" translate="label" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>ClaudeBot (ignores Crawl-delay)</label>
                    <field id="allow" translate="label" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Allow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                    <field id="disallow" translate="label" type="textarea" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Disallow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                </group>

                <group id="applebot" translate="label" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Applebot</label>
                    <field id="allow" translate="label" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Allow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                    <field id="disallow" translate="label" type="textarea" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Disallow paths</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\PathList</backend_model>
                    </field>
                    <field id="crawl_delay" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Crawl-delay (seconds)</label>
                        <backend_model>Angeo\RobotsTxtAeo\Model\Config\Backend\CrawlDelay</backend_model>
                    </field>
                </group>
            </group>

            <!-- ──────────── Sitemap ──────────── -->
            <group id="sitemap" translate="label comment" type="text" sortOrder="30"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Sitemap Directive</label>

                <field id="mode" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sitemap source</label>
                    <comment><![CDATA[How to populate <code>Sitemap:</code> entries in robots.txt. HTTP sitemap URLs are automatically upgraded to HTTPS when the store base URL is HTTPS.]]></comment>
                    <source_model>Angeo\RobotsTxtAeo\Model\Config\Source\SitemapMode</source_model>
                </field>

                <field id="custom_urls" translate="label comment" type="textarea" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom sitemap URLs</label>
                    <comment>One URL per line. Used only when source is "Custom".</comment>
                    <depends>
                        <field id="mode">custom</field>
                    </depends>
                </field>
            </group>

            <!-- ──────────── Live Preview ──────────── -->
            <group id="preview" translate="label" type="text" sortOrder="50"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Live Preview</label>
                <frontend_model>Angeo\RobotsTxtAeo\Block\Adminhtml\System\Config\Preview</frontend_model>
            </group>

        </section>
    </system>
</config>
