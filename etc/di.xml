<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Public API preference: consumers wire to the interface (e.g. Angeo_AeoAudit) -->
    <preference for="Angeo\RobotsTxtAeo\Api\RobotsStatusInterface"
                type="Angeo\RobotsTxtAeo\Model\RobotsStatus"/>

    <!-- Sitemap provider: real implementation safely no-ops when
         Magento_Sitemap is not installed (class_exists check inside).
         Tests use NullMagentoSitemapProvider directly. -->
    <preference for="Angeo\RobotsTxtAeo\Model\Sitemap\MagentoSitemapProviderInterface"
                type="Angeo\RobotsTxtAeo\Model\Sitemap\MagentoSitemapProvider"/>

    <!-- Primary injection point: intercepts Magento\Robots\Model\Robots::getData() -->
    <type name="Magento\Robots\Model\Robots">
        <plugin name="angeo_robots_txt_aeo_model_plugin"
                type="Angeo\RobotsTxtAeo\Plugin\RobotsModelPlugin"/>
    </type>

    <!-- CLI commands -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="angeo_robots_txt_aeo_validate"
                      xsi:type="object">Angeo\RobotsTxtAeo\Console\Command\ValidateCommand</item>
                <item name="angeo_robots_txt_aeo_preview"
                      xsi:type="object">Angeo\RobotsTxtAeo\Console\Command\PreviewCommand</item>
            </argument>
        </arguments>
    </type>

</config>
