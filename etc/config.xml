<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <angeo_robots_txt_aeo>
            <general>
                <enabled>1</enabled>
                <mode>inject</mode>
                <custom_content></custom_content>
            </general>
            <bots>
                <oai_searchbot>1</oai_searchbot>
                <gptbot>1</gptbot>
                <chatgpt_user>1</chatgpt_user>
                <perplexitybot>1</perplexitybot>
                <perplexity_user>1</perplexity_user>
                <google_extended>1</google_extended>
                <claudebot>1</claudebot>
                <anthropic_ai>0</anthropic_ai>
                <claude_user>1</claude_user>
                <claude_searchbot>1</claude_searchbot>
                <oai_adsbot>0</oai_adsbot>
                <applebot>1</applebot>
                <cohere_ai>0</cohere_ai>
                <amazonbot>0</amazonbot>
                <meta_external_agent>0</meta_external_agent>
                <meta_external_fetcher>0</meta_external_fetcher>
                <applebot_extended>0</applebot_extended>
                <ccbot>0</ccbot>
                <bytespider>0</bytespider>
                <mistralai_user>0</mistralai_user>
                <duckassistbot>0</duckassistbot>
            </bots>
            <sitemap>
                <mode>auto</mode>
                <custom_urls></custom_urls>
            </sitemap>
            <content_signals>
                <ietf_enabled>0</ietf_enabled>
                <ietf_preference>train-ai=n</ietf_preference>
                <cloudflare_enabled>0</cloudflare_enabled>
                <!-- Defaults mirror Cloudflare's managed rollout:
                     search=yes, ai-train=no, ai-input left unset -->
                <cf_search>yes</cf_search>
                <cf_ai_train>no</cf_ai_train>
                <cf_ai_input>unset</cf_ai_input>
                <placement>wildcard</placement>
                <policy_comment>1</policy_comment>
            </content_signals>
            <verification>
                <trusted_signature_agents></trusted_signature_agents>
            </verification>
            <licensing>
                <rsl_enabled>0</rsl_enabled>
                <rsl_license_url></rsl_license_url>
            </licensing>
        </angeo_robots_txt_aeo>
    </default>
</config>
